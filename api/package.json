{
  "name": "registry",
  "version": "1.0.0",
  "description": "Production-ready Hono + Drizzle + Bun backend for the registry project",
  "type": "module",
  "module": "src/index.ts",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.ts --target=bun --outdir ./dist",
    "start": "bun ./dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@hono/zod-validator": "latest",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "hono": "latest",
    "hono-rate-limiter": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "postgres": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "latest"
  }
}
