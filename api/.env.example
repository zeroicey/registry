# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# postgres://user:password@host:5432/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/registry
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

# ── Security ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. http://localhost:5173,https://app.example.com
# Use * to allow any origin (disables CSRF origin enforcement and credentials)
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
