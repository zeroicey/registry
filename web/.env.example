# ── App ────────────────────────────────────────────────────────────
# Display name shown in the navbar, footer and welcome page.
VITE_APP_NAME=Registry

# ── API ────────────────────────────────────────────────────────────
# Base URL of the backend API.
#   dev:        use a relative "/api" — Vite proxies it to the Bun backend
#               (see vite.config.ts; target defaults to http://localhost:3000)
#   production: use an absolute URL, e.g. https://api.example.com
VITE_API_BASE_URL=/api

# Dev-only: backend that Vite's "/api" proxy targets. Not used in builds.
# VITE_PROXY_TARGET=http://localhost:3000
